<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Appuyé : relief inversé -->
    <item android:state_pressed="true">
        <layer-list>
            <item><shape><solid android:color="@color/bevel_light" /></shape></item>
            <item android:bottom="2dp" android:right="2dp"><shape><solid android:color="@color/bevel_dark" /></shape></item>
            <item android:bottom="2dp" android:left="2dp" android:right="2dp" android:top="2dp"><shape><solid android:color="@color/panel_pressed" /></shape></item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item><shape><solid android:color="@color/bevel_dark" /></shape></item>
            <item android:bottom="2dp" android:right="2dp"><shape><solid android:color="@color/bevel_light" /></shape></item>
            <item android:bottom="2dp" android:left="2dp" android:right="2dp" android:top="2dp">
                <shape>
                    <gradient android:angle="270" android:endColor="#262935" android:startColor="#3A3E50" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
