<?xml version="1.0" encoding="utf-8"?>
<!-- Panneau en relief : bord clair en haut à gauche, sombre en bas à droite -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape><solid android:color="@color/bevel_dark" /></shape></item>
    <item android:bottom="2dp" android:right="2dp"><shape><solid android:color="@color/bevel_light" /></shape></item>
    <item android:bottom="2dp" android:left="2dp" android:right="2dp" android:top="2dp"><shape><solid android:color="@color/panel" /></shape></item>
</layer-list>
